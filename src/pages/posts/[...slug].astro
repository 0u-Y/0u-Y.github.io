---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import PostLayout from "@/layouts/PostLayout.astro";
import Datetime from "@/components/Datetime.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getPostSlug } from "@/utils/getPostPaths";
export async function getStaticPaths() {
  return getSortedPosts(await getCollection("posts")).map(post => ({
    params: { slug: getPostSlug(post.id, post.filePath).replace(/^\//, "") },
    props: { post },
  }));
}
type Props = { post: CollectionEntry<"posts"> };
const { post } = Astro.props;
const { Content } = await render(post);
const category = post.data.category === "research" ? "Research" : "Open Source";
---

<PostLayout
  lang={post.data.lang}
  title={post.data.title}
  description={post.data.description}
  pubDatetime={post.data.pubDatetime}
  modDatetime={post.data.modDatetime}
>
  <main id="main" lang={post.data.lang}>
    <header class="article-heading">
      <a class="back-link" href={`/${post.data.category}/`}
        >Back to {category}</a
      ><h1>{post.data.title}</h1><div class="article-meta">
        <Datetime pubDatetime={post.data.pubDatetime} />{
          post.data.modDatetime && (
            <span>
              Updated <Datetime pubDatetime={post.data.modDatetime} />
            </span>
          )
        }{post.data.sample && <span class="sample-label">Sample article</span>}
      </div>
    </header>
    {
      post.data.sample && (
        <aside class="sample-notice">
          This is a sample to demonstrate the writing structure. It does not
          describe the author’s actual research or contributions.
        </aside>
      )
    }
    <article class="prose" data-pagefind-body><Content /></article>
    <div class="article-end">
      <a href={`/${post.data.category}/`}>More from {category}</a>
    </div>
  </main>
</PostLayout>
