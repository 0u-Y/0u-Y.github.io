---
import Layout from "@/layouts/Layout.astro";
import { profile } from "@/astro-paper.config";
---

<Layout title={`About — ${profile.name}`}>
  <main id="main">
    <header class="page-heading">
      <h1>About</h1>
    </header>
    <div class="prose">
      <p>
        I’m {profile.name}. I contribute to Ethereum clients, including{" "}
        <a
          href="https://github.com/sigp/lighthouse/pulls?q=is%3Apr+author%3A0u-Y"
          >Lighthouse</a
        >{" "}
        and{" "}
        <a
          href="https://github.com/grandinetech/grandine/pulls?q=is%3Apr+author%3A0u-Y"
          >Grandine</a
        >, and am interested in blockchain research.
      </p>
      <p>
        Here I document core development, research notes, and experiments. I
        also keep a <a href="/open-source/">monthly log</a> of my open-source work.
      </p>
    </div>
    {
      (profile.github || profile.email) && (
        <div class="contact-links">
          {profile.github && <a href={profile.github}>GitHub</a>}
          {profile.email && <a href={`mailto:${profile.email}`}>Email</a>}
        </div>
      )
    }
  </main>
</Layout>

<style>
  .page-heading {
    padding-bottom: 8px;
  }
  .contact-links {
    margin-top: 36px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
</style>
