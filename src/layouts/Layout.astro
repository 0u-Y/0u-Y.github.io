---
import config from "@/config";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import "@fontsource-variable/inter";
import "@/styles/global.css";
import {
  getLanguage,
  localizedPath,
  ui,
  type Language,
  type Translations,
} from "@/i18n";
type Props = {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  lang?: Language;
  translations?: Translations;
};
const {
  lang = getLanguage(Astro.url.pathname),
  title = lang === "ko"
    ? `${config.site.author} — 연구와 오픈소스`
    : config.site.title,
  description = lang === "ko" ? ui.ko.siteDescription : config.site.description,
  canonicalURL = new URL(Astro.url.pathname, Astro.site).href,
  translations = {
    en: localizedPath(Astro.url.pathname, "en"),
    ko: localizedPath(Astro.url.pathname, "ko"),
  },
} = Astro.props;
---

<!doctype html>
<html lang={lang} dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={config.site.author} />
    <meta name="theme-color" content="#faf9f6" />
    <link rel="canonical" href={canonicalURL} />
    {
      Object.entries(translations).map(([language, path]) => (
        <link
          rel="alternate"
          hreflang={language}
          href={new URL(path, Astro.site).href}
        />
      ))
    }
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={config.site.title} />
    <meta property="og:locale" content={lang === "ko" ? "ko_KR" : "en_GB"} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{ui[lang].skip}</a>
    <div class="site-shell">
      <Header {lang} {translations} /><slot /><Footer {lang} />
    </div>
  </body>
</html>
