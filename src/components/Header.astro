---
import { profile } from "@/astro-paper.config";
import { localizedPath, ui, type Language, type Translations } from "@/i18n";
type Props = { lang: Language; translations: Translations };
const { lang, translations } = Astro.props;
const t = ui[lang];
const links = [
  { label: "Home", href: localizedPath("/", lang) },
  { label: "Research", href: localizedPath("/research/", lang) },
  { label: "Open Source", href: localizedPath("/open-source/", lang) },
  { label: "About", href: localizedPath("/about/", lang) },
];
const path = Astro.url.pathname;
---

<header class="site-header">
  <a
    class="wordmark"
    href={localizedPath("/", lang)}
    aria-label={`${profile.name}, ${t.home}`}
    ><svg
      viewBox="0 0 24 28"
      width="20"
      height="24"
      fill="none"
      aria-hidden="true"
      ><path
        d="m12 2 9 12-9 5-9-5L12 2Z"
        stroke="currentColor"
        stroke-width="1.3"></path><path
        d="m3 18 9 8 9-8M12 2v17M3 14l9-3 9 3"
        stroke="currentColor"
        stroke-width="1.3"></path></svg
    ><span>{profile.name}</span></a
  >
  <nav class="main-navigation" aria-label={t.navigation}>
    {
      links.map(link => (
        <a
          href={link.href}
          aria-current={
            path === link.href ||
            (link.href !== localizedPath("/", lang) &&
              path.startsWith(link.href))
              ? "page"
              : undefined
          }
        >
          {link.label}
        </a>
      ))
    }
  </nav>
  <div class="language-switch" role="group" aria-label={t.language}>
    {
      (["en", "ko"] as const).map((language, index) => (
        <>
          {index > 0 && <span aria-hidden="true">/</span>}
          {translations[language] ? (
            <a
              href={translations[language]}
              lang={language}
              hreflang={language}
              aria-label={
                language === "en"
                  ? "Read this page in English"
                  : "이 페이지를 한국어로 읽기"
              }
              aria-current={language === lang ? "page" : undefined}
            >
              {language.toUpperCase()}
            </a>
          ) : (
            <span aria-disabled="true" title={t.unavailable}>
              {language.toUpperCase()}
            </span>
          )}
        </>
      ))
    }
  </div>
</header>
