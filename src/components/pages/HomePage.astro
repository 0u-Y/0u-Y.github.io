---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Card from "@/components/Card.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import config from "@/config";
import { profile } from "@/astro-paper.config";
import Arrow from "@/assets/icons/IconArrowRight.svg";
import { getLanguage, localizedPath, ui } from "@/i18n";
const lang = getLanguage(Astro.url.pathname);
const t = ui[lang];
const posts = getSortedPosts(await getCollection("posts")).filter(
  post => post.data.lang === lang
);
const featured = posts.filter(post => post.data.featured).slice(0, 3);
---

<Layout>
  <main id="main">
    <section class="introduction" aria-labelledby="intro-heading">
      <h1 id="intro-heading">
        {profile.name}<span class="title-period">.</span>
      </h1>
      <p class="intro-copy">
        {lang === "ko" ? profile.introductionKo : profile.introduction}
      </p>
      <div class="intro-links">
        <a href={localizedPath("/research/", lang)}>{t.research} <Arrow /></a><a
          href={localizedPath("/open-source/", lang)}
          >{t["open-source"]} <Arrow /></a
        >
      </div>
      <div class="contact-links">
        {profile.github && <a href={profile.github}>GitHub</a>}
      </div>
    </section>
    {
      featured.length > 0 && (
        <section class="writing-section" aria-labelledby="selected-heading">
          <>
            <div class="section-heading">
              <>
                <h2 id="selected-heading">{t.selected}</h2>
                <span>{t.selectedHint}</span>
              </>
            </div>
            <ul class="post-list">
              {featured.map(post => (
                <Card post={post} featured />
              ))}
            </ul>
          </>
        </section>
      )
    }
    <section class="writing-section" aria-labelledby="recent-heading">
      <div class="section-heading">
        <h2 id="recent-heading">{t.recent}</h2><span>{t.recentHint}</span>
      </div>{
        posts.length ? (
          <ul class="post-list">
            {posts.slice(0, config.posts.perIndex).map(post => (
              <Card post={post} />
            ))}
          </ul>
        ) : (
          <p class="empty-state">{t.noWriting}</p>
        )
      }
    </section>
    <aside class="closing-note">
      {t.closing}
    </aside>
  </main>
</Layout>
