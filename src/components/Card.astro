---
import type { CollectionEntry } from "astro:content";
import Datetime from "./Datetime.astro";
import { getPostUrl } from "@/utils/getPostPaths";
type Props = {
  post: CollectionEntry<"posts">;
  featured?: boolean;
  showCategory?: boolean;
};
const { post, featured = false, showCategory = true } = Astro.props;
const labels = { research: "Research", "open-source": "Open Source" };
---

<li class:list={["post-row", { "featured-row": featured }]}>
  <Datetime pubDatetime={post.data.pubDatetime} />
  <div class="post-summary">
    <h3><a href={getPostUrl(post.id, post.filePath)}>{post.data.title}</a></h3>
    <p lang={post.data.lang}>{post.data.description}</p>
    <div class="post-meta">
      {
        showCategory && (
          <a href={`/${post.data.category}/`}>{labels[post.data.category]}</a>
        )
      }{post.data.format === "monthly" && <span>Monthly report</span>}{
        post.data.sample && <span class="sample-label">Sample</span>
      }
    </div>
  </div>
</li>
