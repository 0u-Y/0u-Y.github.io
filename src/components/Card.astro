---
import type { CollectionEntry } from "astro:content";
import Datetime from "./Datetime.astro";
import { getPostUrl } from "@/utils/getPostPaths";
import { localizedPath, ui } from "@/i18n";
type Props = {
  post: CollectionEntry<"posts">;
  featured?: boolean;
  showCategory?: boolean;
};
const { post, featured = false, showCategory = true } = Astro.props;
const t = ui[post.data.lang];
---

<li class:list={["post-row", { "featured-row": featured }]}>
  <Datetime pubDatetime={post.data.pubDatetime} lang={post.data.lang} />
  <div class="post-summary">
    <h3>
      <a href={getPostUrl(post.id, post.filePath, post.data.lang)}
        >{post.data.title}</a
      >
    </h3>
    <p lang={post.data.lang}>{post.data.description}</p>
    <div class="post-meta">
      {
        showCategory && (
          <a href={localizedPath(`/${post.data.category}/`, post.data.lang)}>
            {t[post.data.category]}
          </a>
        )
      }{post.data.format === "monthly" && <span>{t.monthly}</span>}{
        post.data.sample && <span class="sample-label">{t.sample}</span>
      }
    </div>
  </div>
</li>
